// RelayMesh CKB canonical schemas (Molecule).
// ckbhash = Blake2b-256(personal="ckb-default-hash") over Molecule bytes.
// All integers little-endian fixed arrays (no Molecule number type).

array Byte32 [byte; 32];
array Uint64LE [byte; 8];
array Uint128LE [byte; 16];
vector Bytes <byte>;

// Single node registration entry, sorted by node_id in RegistryData.
table NodeEntry {
    node_id: Byte32,
    wallet_lock_hash: Byte32,
    eligible: byte,
    beats: Uint64LE,
    bytes: Uint64LE,
}

vector NodeEntryVec <NodeEntry>;

table RegistryData {
    registry_id: Byte32,
    operator_lock_hash: Byte32,
    nodes: NodeEntryVec,
}

// One per epoch. Immutable after mint (0x1).
table EpochData {
    schema: Bytes,
    epoch_id: Uint64LE,
    registry_id: Byte32,
    merkle_root: Byte32,
    evidence_hash: Byte32,
    pool_wei: Uint128LE,
    rewards_root: Byte32,
}

// One per (epoch, node) share when funded. Consumed on claim.
table RewardShareData {
    epoch_id: Uint64LE,
    node_id: Byte32,
    wallet_lock_hash: Byte32,
    net_pts: Uint64LE,
    up_pts: Uint64LE,
    bytes: Uint64LE,
    amount: Uint128LE,
}

// Witness payload for Rewards claim: sorted-pair sibling path.
table RewardsWitness {
    proof: Byte32Vec,
}
vector Byte32Vec <Byte32>;
